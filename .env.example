GRAPH_BACKEND=falkordb
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_GRAPH=contextmind
# For a cloud Redis-protocol endpoint, set FALKOR_SSL=true and configure
# FALKOR_USERNAME and FALKOR_PASSWORD in your environment (not in Git).
# Alternatively, use FALKOR_URL=rediss://USER:PASSWORD@HOST:PORT
# Do not set FALKOR_URL together with FALKOR_HOST/PORT/USERNAME/PASSWORD/SSL.
# FALKOR_CA_CERTS=/path/to/provider-ca.pem  # only if a custom CA is needed
# Set for write endpoints outside a local demo
INGEST_TOKEN=change-me
