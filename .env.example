# Copy to .env, enter your API key, then docker compose up --build -d.
# .env is ignored. Never put real credentials in Git or a recording.
LLM_PROVIDER=openai
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
GRAPH_BACKEND=falkordb
FALKOR_GRAPH=contextmind
# For the host Python process, Compose maps its database to localhost:6380.
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=
# Cloud connection: use FALKOR_URL=rediss://... instead of all individual settings;
# remove/comment FALKORDB_HOST/PORT/PASSWORD when setting FALKOR_URL.
# FALKOR_URL=
# FALKOR_SSL=true
# FALKOR_USERNAME=
# FALKORDB_USERNAME= / FALKORDB_SSL= are accepted aliases (hosting dashboards).
# Vercel: keep these names, mark values Sensitive, and use a distinct
# FALKOR_GRAPH (production uses contextmind_vercel). See docs/deployment-vercel.md.
# INGEST_TOKEN=   # optional, never sent to the LLM
